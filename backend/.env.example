APP_NAME=KNCL Transfer Portal

APP_ENV=development

AUTH_MOCK_ENABLED=true
AUTH_MOCK_DEFAULT_ROLE=PLAYER

# Comma-separated browser origins allowed for CORS (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL for welcome emails and password reset redirects
FRONTEND_URL=http://localhost:5173

SECRET_KEY=change_me

DATABASE_URL=

SUPABASE_URL=

SUPABASE_KEY=

SUPABASE_SERVICE_ROLE_KEY=

# Legacy HS256 secret (older Supabase projects). Newer projects use ECC/JWKS via SUPABASE_URL.
SUPABASE_JWT_SECRET=

SUPABASE_STORAGE_BUCKET=documents

MAX_UPLOAD_SIZE_BYTES=10485760

# Optional override for Lichess public API (default: https://lichess.org)
LICHESS_BASE_URL=https://lichess.org

# Optional override for Chess.com public API (default: https://api.chess.com)
CHESSCOM_BASE_URL=https://api.chess.com

# External API cache TTL in seconds (default: 600)
EXTERNAL_API_CACHE_TTL_SECONDS=600

# Rate limit for external lookups per user (default: 30 requests / 60 seconds)
EXTERNAL_API_RATE_LIMIT_REQUESTS=30
EXTERNAL_API_RATE_LIMIT_WINDOW_SECONDS=60

# Email (Resend) — Part 4 onboarding / OTP (see docs/backend_updates.md)
RESEND_API_KEY=
RESEND_FROM_EMAIL=KNCL Portal <noreply@kncl.local>
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_JWT_SECRET=
EMAIL_VERIFICATION_JWT_EXPIRY_SECONDS=900
# Comma-separated origins for CORS (required for browser frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
